# Vite embeds this public URL into the frontend at build time.
# Leave unset for local development through the Vite /api proxy.
# Include /api and use HTTPS for a deployed API.
VITE_API_BASE_URL=https://your-api.example.com/api

# Optional: route local /api requests through Vite to a remote backend.
# Set VITE_API_BASE_URL=/api when using this development-only proxy.
# API_PROXY_TARGET=https://farmers-agroconnect.onrender.com
