PORT=3001
JWT_SECRET=replace-with-a-private-random-secret

# Render production uses a remote Turso libSQL database, not a local disk.
TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token
